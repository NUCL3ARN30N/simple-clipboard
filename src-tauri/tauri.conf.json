{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Simple Clipboard",
  "mainBinaryName": "simple-clipboard",
  "version": "0.2.1",
  "identifier": "com.nucl3arn30n.simpleclipboard",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Simple Clipboard",
        "url": "index.html",
        "width": 380,
        "height": 540,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "nsis",
      "msi"
    ],
    "category": "Utility",
    "shortDescription": "Clipboard history manager",
    "longDescription": "A fast clipboard history manager with pinned items, tags and image support. Replaces the Windows Win+V clipboard history.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "xdotool"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
